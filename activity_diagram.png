.5"></rect><text x="16" y="907" font-size="12" fill="#000000" xml:space="preserve" style="white-space: pre" font-family="sans-serif">Update booking status to Confirmed</text><rect x="25.01" y="940" width="173.42" height="34" rx="12.5" ry="12.5" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></rect><text x="35.01" y="961" font-size="12" fill="#000000" xml:space="preserve" style="white-space: pre" font-family="sans-serif">Generate payment reference</text><rect x="37.69" y="994" width="148.06" height="34" rx="12.5" ry="12.5" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></rect><text x="47.69" y="1015" font-size="12" fill="#000000" xml:space="preserve" style="white-space: pre" font-family="sans-serif">Display payment receipt</text><rect x="237.44" y="832" width="196.75" height="34" rx="12.5" ry="12.5" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></rect><text x="247.44" y="853" font-size="12" fill="#000000" xml:space="preserve" style="white-space: pre" font-family="sans-serif">Display payment failure message</text><rect x="249.13" y="886" width="173.38" height="34" rx="12.5" ry="12.5" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></rect><text x="259.13" y="907" font-size="12" fill="#000000" xml:space="preserve" style="white-space: pre" font-family="sans-serif">Allow visitor to retry payment</text><polygon points="223.77,1034 235.77,1046 223.77,1058 211.77,1046 223.77,1034" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></polygon><rect x="464.19" y="474" width="206.09" height="34" rx="12.5" ry="12.5" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></rect><text x="474.19" y="495" font-size="12" fill="#000000" xml:space="preserve" style="white-space: pre" font-family="sans-serif">Display room unavailable message</text><polygon points="395.5,1064 407.5,1076 395.5,1088 383.5,1076 395.5,1064" fill="#F1F1F1" stroke="#181818" stroke-width="0.5"></polygon><rect x="680.29" y="386" width="142.05" height="34" rx="12.5" ry="12.5" fill="#F1F1F1" stroke="#181