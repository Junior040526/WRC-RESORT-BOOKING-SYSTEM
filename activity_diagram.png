    </style><div style="width: 100%; height: 100%;"><a href="https://ads.bidsystem.ai/click?c=M44Ns7QYBCm4Cxr81J8PUplMYiRxYwVlrjNFQ7A8C0IZoPDUh80EpEmJLxBRs-6WoCbK6GZGQ4Dv-7cq7b2KyHCRO2-RXWG_qfpBnBjVEH1viUAsQOA9lPmLQx_KkJ3ncE3JkqaV98Sjvg9SscnNlgedUC_LDNUf7TEWzE0USkURXvLQTyFJRr1I-vRpA49BjHhof8OCPyrM2LCqgFBXTZWDlQnh9iBcSpgpRjWwEWHyEFBxULU_aA_iUJON_KPDU0OccTdSE49EpA%3D%3D" target="_top" class="bsads-click-link"><style>.sr-ad { box-sizing: border-box; width: 100%; height: 100%; overflow: hidden; position: relative;
  display: flex; background: transparent; color: var(--sr-ink, #111); border: 0; border-radius: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif; cursor: pointer;
  --sr-ink: #111; --sr-muted: #444; --sr-kicker: #6b6b6b; --sr-hair: #e5e5e5; }
.sr-ad * { box-sizing: border-box; margin: 0; }
.sr-thumb { flex: none; position: relative; overflow: hidden; background: #f0f0f0; border-radius: 6px; }
.sr-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center;
  position: absolute; inset: 0; }
.sr-top { display: flex; gap: 10px; min-width: 0; min-height: 0; }
.sr-head { display: flex; flex-direction: column; min-width: 0; flex: 1; gap: 2px; }
.sr-kicker { text-transform: uppercase; letter-spacing: .04em; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis; color: var(--sr-kicker); }
.sr-hl { font-weight: 700; line-height: 1.2; overflow: hidden; display: -webkit-box;
  -webkit-box-orient: vertical; color: var(--sr-ink); min-width: 0; }
.sr-desc { font-weight: 400; line-height: 1.4; overflow: hidden; display: -webkit-box;
  -webkit-box-orient: vertical; color: var(--sr-muted); min-width: 0; }
.sr-meta { display: flex; align-items: baseline; min-width: 0; overflow: hidden; color: var(--sr-muted); }
.sr-meta .sr-lbl, .sr-meta .sr-kicker { display: inline; flex: none; }
.sr-sep { color: var(--sr-kicker); flex: none; padding: 0 .2em; }
.sr-meta .sr-desc { display: block; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; -webkit-line-clamp: unset; }
.sr-foot { display: flex; justify-content: flex-end; align-items: center; flex: none;
  border-top: 1px solid var(--sr-hair); margin-top: 6px; padding-top: 6px; }
.sr-cta { flex: none; color: var(--sr-ink); background: transparent; border: 0; font-weight: 600;
  white-space: nowrap; }
.sr-cta::after { content: " ›"; }
.sr-lbl { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;
  color: var(--sr-kicker); }
.sr-col { display: flex; flex-direction: column; min-width: 0; min-height: 0; flex: 1; }

.sr-dark { --sr-ink: #f4f4f4; --sr-muted: #c8c8c8; --sr-kicker: #c8c8c8; --sr-hair: #3f3f46; }
.sr-dark .sr-hl, .sr-dark .sr-cta { color: #f4f4f4 !important; }
.sr-dark .sr-desc, .sr-dark .sr-kicker, .sr-dark .sr-lbl, .sr-dark .sr-sep, .sr-dark .sr-meta {
  color: #c8c8c8 !important; }
.sr-dark .sr-thumb { background: #27272a; }

/* square 300x250: thumb+headline, description, CTA stacked under copy (no stranded footer) */
.sr-square { flex-direction: column; padding: 12px; gap: 8px; }
.sr-square .sr-thumb { width: 96px; height: 96px; }
.sr-square .sr-kicker { font-size: 11px; }
.sr-square .sr-hl { font-size: 17px; -webkit-line-clamp: 3; }
.sr-square .sr-desc { font-size: 13px; -webkit-line-clamp: 3; flex: none; }
.sr-square .sr-cta { font-size: 13px; }
.sr-square .sr-foot { margin-top: 6px; }
.sr-square.sr-w250 { padding: 10px; gap: 6px; }
.sr-square.sr-w250 .sr-thumb { width: 80px; height: 80px; }
.sr-square.sr-w250 .sr-hl { font-size: 15px; }
.sr-square.sr-w250 .sr-desc { font-size: 12px; }
.sr-square.sr-w250 > .sr-kicker { flex: none; width: 100%; }
.sr-square.sr-w336 .sr-thumb { width: 128px; height: 128px; }

/* tall: photo grows into leftover height; copy+CTA packed below */
.sr-tall { flex-direction: column; }
.sr-tall .sr-thumb { width: 100%; flex: 1 1 auto; min-height: 80px; border-radius: 0; }
.sr-tall .sr-col { padding: 10px 12px 12px; gap: 6px; flex: none; }
.sr-tall .sr-kicker { font-size: 11px; }
.sr-tall .sr-hl { font-size: 18px; -webkit-line-clamp: 3; }
.sr-tall .sr-desc { font-size: 13px; -webkit-line-clamp: 5; flex: none; }
.sr-tall .sr-cta { font-size: 13px; }
.sr-tall .sr-foot { margin-top: 6px; }
.sr-tall.sr-w160 .sr-col { padding: 8px; }
.sr-tall.sr-w160 .sr-hl { font-size: 14px; -webkit-line-clamp: 4; }
.sr-tall.sr-w160 .sr-desc { font-size: 12px; -webkit-line-clamp: 5; }
.sr-tall.sr-w160 .sr-kicker { letter-spacing: 0; white-space: normal; overflow: hidden;
  text-overflow: unset; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.sr-tall.sr-h480 .sr-hl { font-size: 18px; -webkit-line-clamp: 3; }
.sr-tall.sr-noimg { justify-content: center; }
.sr-tall.sr-noimg .sr-col { flex: none; padding: 16px; }
.sr-tall.sr-noimg .sr-hl { font-size: 20px; -webkit-line-clamp: 4; }
.sr-tall.sr-noimg .sr-desc { font-size: 14px; -webkit-line-clamp: 6; }

/* wide 728x90 / unknown: thumb full-height left, copy, text-link far right */
.sr-wide { flex-direction: row; align-items: stretch; }
.sr-wide .sr-thumb { height: 100%; aspect-ratio: 1 / 1; border-radius: 0; }
.sr-wide .sr-col { justify-content: center; padding: 8px 12px; gap: 2px; }
.sr-wide .sr-kicker { font-size: 10px; }
.sr-wide .sr-hl { font-size: 16px; -webkit-line-clamp: 1; }
.sr-wide .sr-desc { font-size: 13px; -webkit-line-clamp: 2; }
.sr-wide .sr-foot { border-top: 0; margin: 0; padding: 0 12px; }
.sr-wide .sr-cta { font-size: 13px; }
.sr-wide.sr-h60 .sr-col { padding: 4px 8px; gap: 1px; }
.sr-wide.sr-h60 .sr-hl { font-size: 13px; -webkit-line-clamp: 1; }
.sr-wide.sr-h60 .sr-meta { font-size: 11px; }
.sr-wide.sr-h60 .sr-meta .sr-desc { font-size: 11px; }
.sr-wide.sr-h60 .sr-cta { font-size: 12px; }
.sr-wide.sr-h60 .sr-foot { padding: 0 8px; }

/* banner 320x100 / 320x50 */
.sr-banner { flex-direction: row; align-items: stretch; }
.sr-banner .sr-thumb { height: 100%; aspect-ratio: 1 / 1; border-radius: 0; }
.sr-banner .sr-col { justify-content: center; padding: 4px 8px; gap: 2px; }
.sr-banner .sr-hl { font-size: 13px; -webkit-line-clamp: 1; }
.sr-banner .sr-cta { font-size: 12px; }
.sr-banner .sr-foot { border-top: 0; margin: 0; padding: 0 8px; }
.sr-banner.sr-h100 .sr-hl { font-size: 13px; }
.sr-banner.sr-h100 .sr-lbl { font-size: 10px; margin: 0; }
.sr-banner.sr-h100 .sr-desc { font-size: 12px; -webkit-line-clamp: 2; }
.sr-banner.sr-h50 .sr-hl { font-size: 12px; }
.sr-banner.sr-h50 .sr-meta { display: flex; }
.sr-banner.sr-h50 .sr-meta, .sr-banner.sr-h50 .sr-meta .sr-desc { font-size: 10px; }
.sr-banner.sr-h50 .sr-meta .sr-desc { white-space: nowrap; display: block; -webkit-line-clamp: unset;
