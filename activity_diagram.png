<script src="./activity_diagram_files/viz-global.js.download"></script>
<script type="module">
	import { render } from "https://plantuml.github.io/plantuml/js-plantuml/plantuml.js";
	const renderOptions = {};
	const textarea = document.getElementById("src");
	function renderNow() {
		render(textarea.value.split(/\r\n|\r|\n/), "out", renderOptions);
	}
	textarea.addEventListener("input", renderNow);
	renderNow();
</script>


<a style="position:relative;top:-38px;" name="3928870aae1e447d"></a>
<!--heading--><h1 class="chap"><div class="dropdown"><button class="dropbtn"><img width="16" height="16" src="./activity_diagram_files/edit1.svg"></button><div class="dropdown-content"><a href="http://alphadoc.plantuml.com/doc/dokuwiki/en/index#0"><img width="20" height="20" src="./activity_diagram_files/dokuwiki.png">Edit in Dokuwiki</a><a href="http://alphadoc.plantuml.com/doc/asciidoc/en/index#0"><img width="20" height="20" src="./activity_diagram_files/asciidoc32.png">Edit in Asciidoc</a><a href="http://alphadoc.plantuml.com/doc/markdown/en/index#0"><img width="20" height="20" src="./activity_diagram_files/markdown.png">Edit in Markdown</a></div></div>🌱 PlantUML at a Glance</h1>
<style>
