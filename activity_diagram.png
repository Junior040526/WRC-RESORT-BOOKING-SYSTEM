.pf-h90 .pf-copy { font-size: calc(14px * var(--pf-k, 1)); -webkit-line-clamp: 2; }
.pf-h100 .pf-pic { width: calc(88px * var(--pf-k, 1)); }
.pf-h100 .pf-copy {
